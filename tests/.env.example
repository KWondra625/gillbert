# Copy to .env (git-ignored) and fill in. Read-only tests need none of these.
# The Staging server's SSH login, and the hostname that server reports for itself:
# cleanup refuses to run against any server whose `hostname` doesn't match.
STAGING_SSH=user@staging-server
STAGING_SSH_HOSTNAME=staging-server
# The Staging database: the Postgres container, its user, and the app database.
PG_CONTAINER=postgres-container
PG_USER=postgres
PG_DB=gillbert
# The Staging storage account's name (blobs live at <name>.blob.core.windows.net). Write
# tests require it, and every test blocks uploads and deletes to any other account.
STAGING_STORAGE_ACCOUNT=
