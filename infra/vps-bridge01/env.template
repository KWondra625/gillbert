# Copy to .env on the server (same folder as docker-compose.yml), fill in, then: chmod 600 .env
# Never commit the real .env. Store every secret in the password manager too.
# Generate secrets with: openssl rand -hex 32

# Timezone for containers and n8n schedules
TZ=America/Chicago

# Public hostname n8n is served at (via Cloudflare Tunnel). Changing it at cutover is a one-line edit.
N8N_HOST=

# Password for n8n's own Postgres (n8n-postgres)
N8N_POSTGRES_PASSWORD=

# Encrypts the credentials stored in n8n. Losing it = every n8n credential must be re-entered.
N8N_ENCRYPTION_KEY=

# Admin (postgres_admin) password for the app Postgres (data-postgres). Apps get their own roles, not this one.
DATA_POSTGRES_PASSWORD=

# NOT in this file, on purpose: per-app Postgres role passwords (gillbert_app, junk_email_app, ...).
# Compose doesn't need them; they live only in the password manager and the matching n8n credentials.

# Token for this server's own Cloudflare Tunnel (Zero Trust → Networks → Tunnels). One tunnel per machine; never reuse another box's token.
CLOUDFLARE_TUNNEL_TOKEN=
