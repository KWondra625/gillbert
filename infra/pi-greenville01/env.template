# Variable names in the Staging server's ~/docker-stack/.env (values only on the server and in
# the password manager; never commit the real .env). chmod 600 .env
# Unlike vps-bridge01, there's no N8N_ENCRYPTION_KEY here: n8n generated its own and keeps it
# in the n8n-data volume (/home/node/.n8n/config).

# PostgreSQL passwords
N8N_POSTGRES_PASSWORD=
DATA_POSTGRES_PASSWORD=

# Cloudflare Tunnel token (pi-greenville01 Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# code-server
CODE_SERVER_PASSWORD=
CODE_SERVER_SUDO_PASSWORD=

# Timezone for containers and n8n schedules
TZ=America/Chicago

# Public hostname n8n is served at (Staging: the lab01 hostname)
N8N_HOST=

# Gillbert: Staging's own Azure storage account (never production's) and its key1
GILLBERT_AZURE_STORAGE_ACCOUNT=
GILLBERT_AZURE_STORAGE_KEY=

# Gillbert: accepted X-API-Key values, as name:key pairs, comma-separated, no spaces
GILLBERT_API_KEYS=

# ntfy (Gillbert new-catch notifications). Fill with notifications/ntfy_secrets.sh, which writes both
# single-quoted (the hash has $ signs). The token goes into n8n's "Gillbert ntfy Publisher" credential.
NTFY_PUBLISHER_HASH=
NTFY_PUBLISHER_TOKEN=
