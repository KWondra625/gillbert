# Copy to backup.env next to backup.sh on the server, fill in, then: chmod 600 backup.env
# Never commit the real backup.env. Keep its values in the password manager too.

# Used in the archive name: <SERVER_NAME>-backup-<date>.tar.gz.gpg
SERVER_NAME=vps-bridge01
STACK_DIR=/home/kurt/docker-stack

# Postgres users the dumps run as (inside the containers)
N8N_PG_USER=n8n_db_user
DATA_PG_USER=postgres_admin

# Encryption passphrase, in its own root-only file (chmod 600). Generate with: openssl rand -base64 32
# Losing it = every backup is unreadable. It lives in the password manager, never in the archive.
PASSPHRASE_FILE=/home/kurt/docker-stack/backup/passphrase

# Local copies: for "undo a bad change"; they don't survive the server dying. Azure covers that.
LOCAL_DIR=/home/kurt/backups
LOCAL_RETENTION_DAYS=30

# Azure: a SAS for this server's container only, permissions Create + Write (no Delete, no Read).
# Old backups are removed by a lifecycle rule on the container, not by this server.
# Keep the SAS in single quotes: this file is loaded as shell, and its & characters would split the line.
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=vps-bridge01-backups
AZURE_SAS_TOKEN=''

# Reporting (optional; leave unset to skip). Each run's result goes to the "Ops - Log Job Run"
# n8n workflow, which logs it to ops.job_runs, posts to Discord, and pages ntfy on failure.
OPS_WEBHOOK_URL=https://bridge01.builtbykw.net/webhook/ops/job-run
OPS_WEBHOOK_KEY=''        # the "Ops Webhook Key" n8n credential value (password manager)
# ntfy topic the script pages directly when n8n itself can't be reached
NTFY_URL=
